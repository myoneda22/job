# Copy to .env and fill in.  .env is git-ignored — never commit real keys.
#
# Gemini (required).  Issue / rotate at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Default Gemini model.  See `python -m gemini_link.cli models` for the live list.
# Recommended: gemini-3.7-flash (fast, GA).  Heavier: gemini-3.1-pro-preview
# NOTE: gemini-2.5-* is listed by the API but returns 404 for keys created recently.
GEMINI_MODEL=gemini-3.7-flash

# Anthropic (optional).  Only needed for the Claude <-> Gemini comparison feature.
# Without it, `compare` degrades to Gemini-only and says so.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional tuning
# url_context page fetches have been measured at up to ~140s; keep headroom.
GEMINI_TIMEOUT=180
GEMINI_MAX_RETRIES=4
