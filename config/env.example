# 環境変数リファレンス / チューニング例
# 必要なものだけをシェルの rc、MCP 設定の env、または .env に入れてください。
# ※ このファイル自体に認証情報を書かないこと。

# ============================================================
# 共通（Windows 文字化け対策 / docs/04）
# ============================================================
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# ============================================================
# notebooklm-py
# ============================================================

# 認証プロファイル。並行エージェントはここを分けてコンテキスト競合を避ける
# NOTEBOOKLM_PROFILE=agent-1

# プロファイル群の置き場所を変える（既定: ~/.notebooklm）
# NOTEBOOKLM_HOME=/tmp/agent-1

# 保存済み認証 JSON を直接指定（GUI の無いホストへ持ち込む場合）
# ⚠️ Google のセッションクッキーそのもの。パス管理に注意
# NOTEBOOKLM_AUTH_JSON=/secure/path/storage_state.json

# ログレベル: DEBUG / INFO / WARNING(既定) / ERROR
# NOTEBOOKLM_LOG_LEVEL=INFO

# RPC エラー時に生レスポンスを保持（既定は 80 文字で切り詰め）
# NOTEBOOKLM_DEBUG=1

# MCP を非ループバックに bind する（既定は拒否される）
# ⚠️ 認証情報を握ったサーバーを素の HTTP で公開しないこと
# NOTEBOOKLM_MCP_ALLOW_EXTERNAL_BIND=1

# ============================================================
# notebooklm-mcp（Node / Chrome 自動化）
# ============================================================

# --- ツール公開範囲 ---
# minimal(5) / standard(10) / full(既定・全ツール)
# NOTEBOOKLM_PROFILE=minimal
# NOTEBOOKLM_DISABLED_TOOLS=cleanup_data,re_auth

# --- ブラウザ ---
# HEADLESS=true                      # 既定 true
# BROWSER_CHANNEL=chromium           # Chrome が起動しない場合に同梱 Chromium を強制
# NOTEBOOK_PROFILE_STRATEGY=isolated # プロファイルロック回避（既定 auto）

# --- タイムアウト ---
# ANSWER_TIMEOUT_MS=900000           # 回答待ちの上限（既定 600000 = 10 分）
# BROWSER_TIMEOUT=30000              # 個々のブラウザ操作
# MAX_SESSIONS=10                    # 同時ブラウザセッション数
# SESSION_TIMEOUT=900                # アイドル秒数で GC

# --- ステルス（Google の自動化検知対策） ---
# ⚠️ 無効化はアカウントへの影響を理解したうえで
# STEALTH_ENABLED=true
# STEALTH_HUMAN_TYPING=false
# TYPING_WPM_MIN=400
# TYPING_WPM_MAX=600

# --- 回答の加工 ---
# NOTEBOOKLM_AI_MARKER=false         # 回答先頭の [AI-GENERATED ...] を外す
# NOTEBOOKLM_AI_MARKER_PREFIX=[notebooklm]
# NOTEBOOKLM_FOLLOW_UP_REMINDER=true # v1 のフォローアップ文言を復活

# --- トランスポート ---
# NOTEBOOKLM_TRANSPORT=http
# NOTEBOOKLM_PORT=3000
# NOTEBOOKLM_HOST=127.0.0.1

# --- マルチアカウント ---
# NOTEBOOKLM_ACCOUNT=work            # [a-z0-9][a-z0-9-_]{0,30}
